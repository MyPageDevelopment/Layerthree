// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  GERENTE
  JEFE
  TECNICO
}

enum MovementType {
  ENTRY
  EXIT
}

enum ProductCategory {
  EQUIPOS
  RED
  FIBRA_OPTICA
  ELECTRICIDAD
  CANALIZACION
  INSUMOS
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  name             String?
  role             UserRole    @default(TECNICO)
  isActive         Boolean     @default(true)
  allowedModules   String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  movements Movement[]

  @@map("users")
}

model Product {
  id          String          @id @default(uuid())
  sku         String          @unique
  name        String
  description String?         @db.Text
  category    ProductCategory @default(EQUIPOS)
  subcategory String?
  stock       Int             @default(0)
  minStock    Int             @default(0)
  unitPrice   Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   Movement[]

  @@index([sku])
  @@index([category])
  @@map("products")
}

model Movement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  projectId String?
  type      MovementType
  quantity  Int
  notes     String?      @db.Text
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([projectId])
  @@index([createdAt])
  @@map("movements")
}

model ProductAudit {
  id          String   @id @default(uuid())
  productId   String
  productSku  String
  productName String
  action      String   // CREATE, UPDATE, DELETE
  userId      String
  userName    String
  userEmail   String
  userRole    UserRole
  changes     String?  @db.Text // JSON con los cambios realizados
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("product_audits")
}
