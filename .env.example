# ====================================================================
# CONFIGURACIÓN DEL SISTEMA DE BODEGA
# ====================================================================

# --------------------------------------------------------------------
# BASE DE DATOS
# --------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=inventory_db

# --------------------------------------------------------------------
# REDIS (Message Broker & Cache)
# --------------------------------------------------------------------
# Generar con: openssl rand -base64 32
REDIS_PASSWORD=redis_secure_password

# --------------------------------------------------------------------
# AUTENTICACIÓN JWT
# --------------------------------------------------------------------
# IMPORTANTE: Generar secret aleatorio con: openssl rand -base64 64
JWT_SECRET=LT-bodega-secret-key-2025-super-secure
JWT_REFRESH_SECRET=LT-bodega-refresh-key-2025-super-secure
# Access token: 1 hora (seguridad mejorada)
JWT_EXPIRATION=1h
JWT_EXPIRES_IN=1h
# Refresh token: 7 días
JWT_REFRESH_EXPIRATION=7d

# --------------------------------------------------------------------
# ENTORNO
# --------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# --------------------------------------------------------------------
# SERVICIO DE EMAIL (SMTP)
# Configurar para habilitar notificaciones por correo
# --------------------------------------------------------------------

# Opción 1: Gmail
# 1. Habilita autenticación de 2 pasos en tu cuenta Gmail
# 2. Genera contraseña de aplicación: https://myaccount.google.com/security
# 3. Copia la contraseña de 16 caracteres aquí
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Opción 2: Outlook/Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@empresa.com
# SMTP_PASS=tu-contraseña

# Opción 3: Servidor SMTP Corporativo
# SMTP_HOST=mail.tuempresa.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=sistema@tuempresa.com
# SMTP_PASS=contraseña-segura

# Remitente del correo (personalizar)
EMAIL_FROM=Sistema Bodega <noreply@bodega.local>
